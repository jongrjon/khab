# Copy to .env and fill in. Never commit .env.
# On the prod box, scripts/prepare-server.sh writes most of these for you.

# --- Django ---
SECRET_KEY=generate-me
DEBUG=False
# Comma-separated. The app is reached by IP, so list every address people
# actually type — with DEBUG=False, Django returns 400 for any Host not here.
# scripts/prepare-server.sh detects the box's own addresses and writes them.
# The healthcheck uses the FIRST entry as its Host header.
ALLOWED_HOSTS=192.0.2.10
# Only needed if the site is ever served over HTTPS or on a non-default port,
# e.g. https://192.0.2.10
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Required. docker-compose.prod.yaml refuses to start without it.
POSTGRES_PASSWORD=generate-me
# docker-compose.prod.yaml sets this for the container and overrides whatever
# is here. In prod the db publishes no host port, so this URL is not reachable
# from the host — use `docker compose ... exec app python manage.py ...`.
DATABASE_URL=postgres://khab:generate-me@db:5432/khab

# --- Email (Gmail SMTP, for invite links) ---
# The password committed here before 2026-08 is public and must not be reused.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Runtime tuning (optional) ---
# Set to 1 after the first successful avatar import to keep deploys quick.
SKIP_AVATAR_FETCH=0
GUNICORN_WORKERS=3
